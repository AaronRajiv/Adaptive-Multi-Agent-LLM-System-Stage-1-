# ==============================================================================
# Adaptive Multi-Agent LLM System - Stage 1 Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported in Stage 1: 'gemini', 'mock'
# (Generic architecture supports future expansion to 'openai', 'groq', 'openrouter', 'anthropic')
LLM_PROVIDER=gemini

# API Key for the configured LLM provider (leave empty or set for Gemini)
# Do NOT commit your actual API key to version control!
LLM_API_KEY=

# LLM Model Name (e.g. gemini-1.5-flash, gemini-1.5-pro)
LLM_MODEL=gemini-1.5-flash

# Evaluator Pass Threshold (0-100 score required for PASS status)
EVALUATOR_PASS_THRESHOLD=80

# CORS Allowed Origins (comma-separated list for frontend access)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8082

# Stage 5 Knowledge Base / RAG (optional)
# Use mock for deterministic local tests; Gemini uses EMBEDDING_API_KEY or falls back to LLM_API_KEY.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
# PostgreSQL connection for the optional pgvector repository; leave blank for in-memory development/testing.
KNOWLEDGE_DATABASE_URL=
# Must match the VECTOR dimension used when creating the pgvector schema.
KNOWLEDGE_EMBEDDING_DIMENSIONS=768
